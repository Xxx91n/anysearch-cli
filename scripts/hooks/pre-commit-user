#!/bin/sh
# anysearch pre-commit: run the tests this commit can break — the staged
# workspace packages plus every package that depends on them — before it lands.
# A change outside apps/ and packages/ falls back to the full workspace suite.
# Install:  cp scripts/hooks/pre-commit-user .git/hooks/pre-commit-user && chmod +x .git/hooks/pre-commit-user
# GitButler's managed pre-commit hook chains to this one (it runs pre-commit-user first).
exec node "$(git rev-parse --show-toplevel)/scripts/preflight-test.mjs" --staged
