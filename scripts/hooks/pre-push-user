#!/bin/sh
# anysearch push gate — hooks:status recognizes this file by this line and the exec
# below: keep both as they are, or the hook reads as someone else's.
# anysearch pre-push: run the tests this push can break — the changed workspace
# packages plus every package that depends on them — before anything leaves the
# machine. `--pushed` makes the script read the refs git hands the hook on stdin.
# A root file the plan's reader table names runs only the packages that read it;
# a push that carries only documentation runs nothing and says it skipped. A
# change no package owns is skipped the same way, and its coverage is CI's
# check-build lane; a repository the gate cannot read stops the push with exit 2.
# Install and check it from the repo root: pnpm hooks:install / pnpm hooks:status
# (pnpm -w … from a subdirectory). AGENTS.md has both.
# Fires for `git push` and for GitButler's push: `but push` runs pre-push hooks by default
# (see `but push --help`: "--no-hooks, --no-verify  Bypass pre-push hooks").
# The pre-push hook is NOT GitButler-managed (GitButler only manages
# pre-commit/post-checkout), so this file stays ours.
exec node "$(git rev-parse --show-toplevel)/scripts/preflight-test.mjs" --pushed
