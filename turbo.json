{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "lib/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "check": {},
    "@anysearch-cli/dsh-plugin#test": {
      "dependsOn": [
        "build",
        "^test"
      ]
    },
    "@anysearch-cli/cli#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "dist/**",
        "mcp/**",
        "plugin/**",
        "domains/**",
        ".build-stamp.json"
      ]
    }
  }
}
