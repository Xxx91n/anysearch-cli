* text=auto eol=lf

# git 的 wildmatch 不认 `*.{bat,ps1,cmd}` 这种花括号，写了等于没写（以前 .bat
# 还是 eol: lf）。一行一个后缀，`git check-attr` 才真的认。
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# 同上：二进制后缀逐个列。以前那行花括号无效，.png 还在按 text 处理。
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.exe binary
*.dll binary
*.node binary
*.pdb binary
*.msi binary
*.so binary
*.dylib binary
*.bin binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary

# schema-content.ts 是 schema.sql 压成的一行内联字符串，diff 不可读；
# 评审只看 schema.sql，这个文件默认折叠。
packages/store/src/schema-content.ts linguist-generated=true
