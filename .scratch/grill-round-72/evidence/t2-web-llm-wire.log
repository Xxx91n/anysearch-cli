trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"x.com/madzadev/status/2081308770014240844?lang=de\",\n      \"title\": \"Madza 👨💻⚡ auf X: „AnySearch is search infrastructure built for Al agents. It handles intent routing, source diversity, and content cleaning at the retrieval layer so your agent gets structured, citable results it can reason on directly, not raw web noise to post-process. If you are building agents that need real-time, cross-domain retrieval without stitching together a dozen separate tools, it is worth integrating. AnySearch is also running a discount program for verified students and develope\",\n      \"snippet\": \"AnmeldenRegistrieren\\n\\n## Post\\n\\n user avatar\\n\\n  Madza 👨💻⚡\\n\\n  26. Juli\\n\\n  Introducing @AnySearchAI - the search infrastructure your AI can actually trust. AnySearch gives your projects: → One API call, cross-domain results → Clean Markdown output, zero HTML noise → Same-source decay prevents result clustering → Hybrid ranking: semantic relevance\\n\\n  \\n\\n  00:00\\n\\n  Gesponserte Partnerschaft\\n\\n  4473\\n user avatar\\n\\n  Madza 👨💻⚡\\n\\n  @madzadev\\n\\n  26. Juli [...] AnySearch is search infrastructure built \",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.7098244,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"stripped\",\n        \"trustSuspicious\": true\n      }\n    },\n    {\n      \"url\": \"github.com/JZKK720/anysearch-skill\",\n      \"title\": \"GitHub - JZKK720/anysearch-skill: Unified real-time search engine skill for AI agents. · GitHub\",\n      \"snippet\": \"Important: do not assume `python` exists. On many macOS systems, the correct executable is `python3`. Check both `python` and `python3`; if either works, Python is available.\\n\\n### Step 2: Run entry test (probe all available runtimes)\\n\\nRun the `doc` command with each available runtime to verify the skill works, and observe which runs without errors or warnings: [...] Key priority order: `--api_key` CLI flag > `.env` file > environment variable > anonymous\\n\\n## Post-Install Verification\\n\\nAfter inst\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.6728693,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"watcha.cn/reply/22247\",\n      \"title\": \"AnySearch - 猹评详情｜观猹\",\n      \"snippet\": \"首页图鉴排行猹评猹馆活动瓜棚\\n\\n详情\\n\\navatar\\n\\n硬气一点\\n\\nAnySearchAnySearch·BAD\\n\\n首先，我觉得这个网页设计问题很大！\\n\\n既然有中文页面，咱能不能先把首页语言切换做好....\\n\\n搜索完的结果不在第一屏，要下翻到第二页，我前几次都不知道还下面还有内容，以为检索失败\\n\\n然后，我也试了一下让 agent 去进行信息检索，因为产品主打一个专业搜索，我就给他布置了 “帮我调研一下 杭州似一科技有限公司（以网络用户的关心的视角检索）” 的任务并和 DeepSeek 网页端进行对比，图 3 是使用 Hermes 调用AnySearch返回的结果；图 4 是DeepSeek 专家模式的结果；调用 skills 的内容更简洁，但我个人比较喜欢 deepseek 的内容，虽然废话有点多，但抓住了很多有意思的话题，比如创始人仲泰的创业经历、产品名观猹由来的解读等等。\\n\\n至于整体使用好与坏，我也让 agent 自己去给我了一个判断，放在后面的图片里面了。\\n\\n我的 agent 比较傲娇，结论就是\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.66268736,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"taiwannews.com.tw/news/6359391\",\n      \"title\": \"AnySearch Launches as Search Infrastructure Built for AI Agents | Taiwan News | May. 11, 2026 16:36\",\n      \"snippet\": \"To address this challenge, AnySearch aggregates extensive vertical data sources spanning finance, legal, academic research, cybersecurity, energy, and corporate intelligence, among other specialized domains. Through a single unified API, AI agents can directly retrieve accurate, structured results without requiring developers to manage dozens of disparate data interfaces. AnySearch natively supports Skill, MCP, and API connectivity, enabling seamless integration into AI agents, enterprise [...] \",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.6444489,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"youtube.com/watch?v=opfrqlxS23A\",\n      \"title\": \"AnySearch — Real-time structured search trusted by agents and developers\",\n      \"snippet\": \"# AnySearch — Real-time structured search trusted by agents and developers\\n## Fox SaaS Solutions\\n7 subscribers\\n1 likes\\n\\n### Description\\n123 views\\nPosted: 6 Jul 2026\\nReal-time structured search trusted by agents and developers\\nAnySearch delivers real-time structured search that AI agents and developers can rely on — understands intent, filters noise, returns better results.\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.62874943,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"dsh-hub.cc/plugins/anysearch-team/anysearch-dsh\",\n      \"title\": \"anysearch-team/anysearch-dsh：DSH 插件 | DSH Hub\",\n      \"snippet\": \"English | 简体中文\\n\\n`@anysearch/anysearch-dsh` connects AnySearch to DeepSeek Harness as a plugin. Keep using Harness's native `web_search` and `web_fetch` while gaining real-time web search, cleaned URL content, vertical search, and concurrent batch search.\\n\\nAnySearch is search infrastructure for AI agents, covering the public web and specialized data sources across code, finance, academia, law, security, and more.\\n\\n## Quick start\\n\\n### For AI Agents [...] ## Tools\\n\\n| Use case | Harness tool |\\n --- \",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.62874943,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"chatgate.ai/post/anysearch\",\n      \"title\": \"AnySearch: Real-time structured search trusted by agents and developers | ChatGate\",\n      \"snippet\": \"Try ChatGate\\n\\nAnySearch: Real-time structured search trusted by agents and developers\\n\\n# AnySearch: Real-time structured search trusted by agents and developers\\n\\nAnySearch is search infrastructure that gives AI agents current, structured information through an API, MCP server, or installable Skill. It is aimed at builders who want retrieval inside an agent workflow rather than a human-facing list of blue links.\\n\\n## What does AnySearch actually return to an agent? [...] AnySearch remains an exter\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.6271523,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"nationalworld.com/must-read/anysearch-launches-ai-programme-8824821\",\n      \"title\": \"AnySearch launches programme to aid next-gen AI builders\",\n      \"snippet\": \"AnySearch is building search infrastructure for the AI era, offering AI agents a unified gateway to timely, verifiable information. Developers can integrate AnySearch into their agents, workflows, and smart applications via API, MCP, and skill-based interfaces, enabling AI systems to search timely, accurate, and fully traceable information for reliable task execution. To date, more than 200,000 developers worldwide have used AnySearch, with cumulative search calls exceeding 20 million.\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.62646705,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    },\n    {\n      \"url\": \"leiphone.com/tag/AnySearch\",\n      \"title\": \"AnySearch_AnySearch资讯_AnySearch最新信息_雷峰网\",\n      \"snippet\": \"雷峰网 \\n\\n 雷峰网公开课\\n 活动中心\\n GAIR\\n 专题\\n 爱搞机\\n\\n热门标签 AnySearch\\n\\n# AnySearch\\n\\n本专题为雷峰网的AnySearch专题，内容全部来自雷峰网精心选择与AnySearch相关的最近资讯，雷峰网读懂智能与未来，拥有AnySearch资讯的信息，在这里你能看到未来的世界。\\n\\n []( \\n\\n  上线一周登顶 Skill 商店热榜，AnySearch 正在重构“AI 时代搜索引擎”\\n\\n## AnySearch最新资讯\\n\\n相关文章\\n\\n热门搜索\\n\\n人脸识别 3D打印 收购 可穿戴 CVPR zynga DIY 清华大学 聊天机器人 李飞飞 处理器\\n\\n为了您的账户安全，请验证邮箱\\n\\n您的邮箱还未验证,完成可获20积分哟！\\n\\n重发邮箱修改邮箱\\n\\n您的账号已经绑定，现在您可以设置密码以方便用邮箱登录\\n\\n立即设置 以后再说\",\n      \"source\": \"tavily\",\n      \"extra\": {\n        \"score\": 0.62452257,\n        \"trustLabel\": {\n          \"source\": \"retrieved\",\n          \"traceId\": \"5ba1a8eabf6b43ad969e9e087c4b77a1\"\n        },\n        \"trustDisposal\": \"accepted\",\n        \"trustSuspicious\": false\n      }\n    }\n  ],\n  \"answers\": [],\n  \"answersAvailable\": true,\n  \"providerAnswers\": [],\n  \"providersQueried\": [\n    \"tavily\",\n    \"anysearch\"\n  ],\n  \"attribution\": {\n    \"schema\": \"anysearch/attribution-report@1\",\n    \"generatedAt\": \"2026-09-19T06:54:25.914Z\",\n    \"claims\": [],\n    \"gaps\": [],\n    \"supportedCount\": 0,\n    \"uncertainCount\": 0,\n    \"unsupportedCount\": 0,\n    \"judgeEnhanced\": false\n  },\n  \"abstain\": null,\n  \"sufficiency\": {\n    \"verdict\": \"ambiguous\",\n    \"agreement\": {\n      \"jaccardAtK\": 0,\n      \"rboAtK\": 0\n    },\n    \"volume\": {\n      \"uniqueResults\": 10,\n      \"uniqueDomains\": 10,\n      \"successfulProviders\": 1\n    },\n    \"spread\": {\n      \"rrfVariance\": 0\n    }\n  }\n}","tool_call_id":"call_3"},{"role":"user","content":"[anysearch preheat] Relevant prior results from project index:\n- R72 prior probe: preheated memory hit"},{"role":"user","content":"{\"tool\":\"mcp__anysearch__search_web\",\"query\":\"anysearch r72 clean probe\",\"resultCount\":10,\"topResults\":[{\"title\":\"https://raw.githubusercontent.com/dhruv-anand-aintech/anysearch/main/README.md\",\"url\":\"raw.githubusercontent.com/dhruv-anand-aintech/anysearch/main/README.md\"},{\"title\":\"Madza 👨💻⚡ auf X: „AnySearch is search infrastructure built for Al agents. It handles intent routing, source diversity, and content cleaning at the retrieval layer so your agent gets structured, citable results it can reason on directly, not raw web noise to post-process. If you are building agents that need real-time, cross-domain retrieval without stitching together a dozen separate tools, it is worth integrating. AnySearch is also running a discount program for verified students and develope\",\"url\":\"x.com/madzadev/status/2081308770014240844?lang=de\"},{\"title\":\"GitHub - JZKK720/anysearch-skill: Unified real-time search engine skill for AI agents. · GitHub\",\"url\":\"github.com/JZKK720/anysearch-skill\"}]}"}],"stream":true,"stream_options":{"include_usage":true},"store":false,"max_completion_tokens":1,"tools":[{"type":"function","function":{"name":"mcp__anysearch__ans_chat","description":"Run the anysearch agent loop: retrieval-augmented chat with LLM. Uses PiAgentRuntime with domain-aware tool filtering.","parameters":{"type":"object","properties":{"message":{"minLength":1,"description":"The user message to send to the agent","type":"string"}},"required":["message"],"additionalProperties":false},"strict":false}},{"type":"function","function":{"name":"mcp__anysearch__query_knowledge","description":"Query domain-specific knowledge base via RAG adapt