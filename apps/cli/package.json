{
  "name": "@anysearch-cli/cli",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "ans": "bin/ans.cjs",
    "ans-mcp": "bin/ans-mcp.cjs",
    "ans-plugin-server": "bin/ans-plugin-server.cjs",
    "ans-hook-claude": "bin/ans-hook-claude.cjs",
    "ans-hook-session-start": "bin/ans-hook-session-start.cjs",
    "ans-hook-codex": "bin/ans-hook-codex.cjs",
    "ans-hook-antigravity": "bin/ans-hook-antigravity.cjs",
    "ans-hook-codebuddy": "bin/ans-hook-codebuddy.cjs"
  },
  "files": [
    "dist",
    "domains",
    "bin",
    "mcp",
    "plugin"
  ],
  "scripts": {
    "build": "node scripts/sync-domains.mjs && tsup && node scripts/build-product.mjs && node scripts/stamp-dist.mjs",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" --test-timeout=30000",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@sinclair/typebox": "^0.34.52",
    "@tavily/core": "^0.7.7",
    "better-sqlite3": "^13.0.3",
    "eventsource-parser": "^4.1.1",
    "exa-js": "^2.26.0",
    "express": "^4.21.0",
    "smol-toml": "^1.8.0",
    "yaml": "2.9.0",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anysearch-cli/kernel": "workspace:*",
    "@anysearch-cli/mcp": "workspace:*",
    "@anysearch-cli/plugin": "workspace:*",
    "@anysearch-cli/retriever": "workspace:*",
    "@anysearch-cli/store": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@anysearch-cli/embedding": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anysearch-cli/embedding": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxx91n/anysearch-cli.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
