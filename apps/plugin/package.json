{
  "name": "@anysearch-cli/plugin",
  "version": "0.0.3",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.cjs"
    },
    "./hooks/core": {
      "types": "./src/hooks/core.ts",
      "default": "./dist/hooks/core.cjs"
    },
    "./hooks/distill": {
      "types": "./src/hooks/distill.ts",
      "default": "./dist/hooks/distill.cjs"
    },
    "./hooks/preheat": {
      "types": "./src/hooks/preheat.ts",
      "default": "./dist/hooks/preheat.cjs"
    },
    "./hooks/session-start": {
      "types": "./src/hooks/session-start.ts",
      "default": "./dist/hooks/session-start.cjs"
    },
    "./hooks/adapters/claude": {
      "types": "./src/hooks/adapters/claude.ts",
      "default": "./dist/hooks/adapters/claude.cjs"
    },
    "./hooks/adapters/cursor": {
      "types": "./src/hooks/adapters/cursor.ts",
      "default": "./dist/hooks/adapters/cursor.cjs"
    },
    "./hooks/adapters/codex": {
      "types": "./src/hooks/adapters/codex.ts",
      "default": "./dist/hooks/adapters/codex.cjs"
    },
    "./hooks/adapters/antigravity": {
      "types": "./src/hooks/adapters/antigravity.ts",
      "default": "./dist/hooks/adapters/antigravity.cjs"
    },
    "./hooks/adapters/codebuddy": {
      "types": "./src/hooks/adapters/codebuddy.ts",
      "default": "./dist/hooks/adapters/codebuddy.cjs"
    }
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:hooks",
    "build:hooks": "esbuild src/hooks/core.ts src/hooks/distill.ts src/hooks/preheat.ts src/hooks/session-start.ts src/hooks/adapters/claude.ts src/hooks/adapters/cursor.ts src/hooks/adapters/codex.ts src/hooks/adapters/antigravity.ts src/hooks/adapters/codebuddy.ts --bundle --platform=node --format=cjs --outdir=dist/hooks --outbase=src/hooks --out-extension:.js=.cjs --external:better-sqlite3 --external:@anysearch-cli/embedding",
    "build:server": "tsup",
    "dev": "tsx src/server/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" --test-timeout=30000",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@anysearch-cli/kernel": "workspace:*",
    "@anysearch-cli/retriever": "workspace:*",
    "@anysearch-cli/store": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "configs"
  ],
  "main": "./dist/index.cjs",
  "peerDependencies": {
    "@anysearch-cli/embedding": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anysearch-cli/embedding": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxx91n/anysearch-cli.git",
    "directory": "apps/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ans-plugin-server": "dist/server/index.cjs"
  }
}
