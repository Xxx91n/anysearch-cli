{
  "name": "@anysearch/plugin",
  "version": "0.0.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.cjs"
    },
    "./hooks/core": {
      "types": "./src/hooks/core.ts",
      "default": "./dist/hooks/core.cjs"
    },
    "./hooks/distill": {
      "types": "./src/hooks/distill.ts",
      "default": "./dist/hooks/distill.cjs"
    },
    "./hooks/preheat": {
      "types": "./src/hooks/preheat.ts",
      "default": "./dist/hooks/preheat.cjs"
    },
    "./hooks/session-start": {
      "types": "./src/hooks/session-start.ts",
      "default": "./dist/hooks/session-start.cjs"
    },
    "./hooks/adapters/claude": {
      "types": "./src/hooks/adapters/claude.ts",
      "default": "./dist/hooks/claude.cjs"
    },
    "./hooks/adapters/cursor": {
      "types": "./src/hooks/adapters/cursor.ts",
      "default": "./dist/hooks/cursor.cjs"
    },
    "./hooks/adapters/codex": {
      "types": "./src/hooks/adapters/codex.ts",
      "default": "./dist/hooks/codex.cjs"
    },
    "./hooks/adapters/antigravity": {
      "types": "./src/hooks/adapters/antigravity.ts",
      "default": "./dist/hooks/antigravity.cjs"
    }
  },
  "scripts": {
    "build": "pnpm run build:hooks && pnpm run build:server",
    "build:hooks": "pnpm run build:core && pnpm run build:distill && pnpm run build:preheat && pnpm run build:session-start && pnpm run build:adapters",
    "build:core": "esbuild src/hooks/core.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/core.cjs --external:better-sqlite3",
    "build:distill": "esbuild src/hooks/distill.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/distill.cjs --external:better-sqlite3",
    "build:preheat": "esbuild src/hooks/preheat.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/preheat.cjs --external:better-sqlite3",
    "build:adapters": "pnpm run build:claude && pnpm run build:cursor && pnpm run build:codex && pnpm run build:antigravity",
    "build:claude": "esbuild src/hooks/adapters/claude.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/claude.cjs --external:./core.cjs",
    "build:cursor": "esbuild src/hooks/adapters/cursor.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/cursor.cjs --external:./core.cjs",
    "build:codex": "esbuild src/hooks/adapters/codex.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/codex.cjs --external:./core.cjs",
    "build:antigravity": "esbuild src/hooks/adapters/antigravity.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/antigravity.cjs --external:./core.cjs",
    "build:server": "tsup",
    "dev": "tsx src/server/index.ts",
    "lint": "tsc --noEmit",
    "test": "tsx test/plugin.test.ts",
    "check": "tsc --noEmit",
    "build:session-start": "esbuild src/hooks/session-start.ts --bundle --platform=node --format=cjs --outfile=dist/hooks/session-start.cjs --external:better-sqlite3",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@anysearch/kernel": "workspace:*",
    "@anysearch/retriever": "workspace:*",
    "@anysearch/store": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs"
}
