{
  "hooks": {
    "preToolUse": [
      {
        "name": "anysearch-preheat",
        "command": "node",
        "args": [
          "${CURSOR_PLUGIN_DIR}/../dist/hooks/preheat.cjs"
        ],
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "name": "anysearch-distill",
        "command": "node",
        "args": [
          "${CURSOR_PLUGIN_DIR}/../dist/hooks/distill.cjs"
        ],
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "name": "anysearch-session-start",
        "command": "node",
        "args": [
          "${CURSOR_PLUGIN_DIR}/../dist/hooks/session-start.cjs"
        ],
        "timeout": 5
      }
    ]
  }
}
