{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*(search_web|research_web|recall_memory|query_knowledge|ans_chat)$",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(search_web|research_web|recall_memory|query_knowledge|ans_chat)$",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-session-start --envelope",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
