{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "search_web|research_web|recall_memory|query_knowledge|ans_chat",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-codebuddy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "search_web|research_web|recall_memory|query_knowledge|ans_chat",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-codebuddy",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ans-hook-codebuddy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
