{
  "name": "@anysearch-cli/mcp",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "ans-mcp": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.cjs",
    "./server": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" --test-timeout=30000",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anysearch-cli/kernel": "workspace:*",
    "@anysearch-cli/plugin": "workspace:*",
    "@anysearch-cli/retriever": "workspace:*",
    "@anysearch-cli/store": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "types": "./dist/index.d.cts",
  "peerDependencies": {
    "@anysearch-cli/embedding": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anysearch-cli/embedding": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxx91n/anysearch-cli.git",
    "directory": "apps/mcp"
