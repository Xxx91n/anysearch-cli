{
  "name": "@anysearch/mcp",
  "version": "0.1.0-rc.0",
  "type": "module",
  "bin": {
    "ans-mcp": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.cjs",
    "./server": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" --test-timeout=30000",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@anysearch/kernel": "workspace:*",
    "@anysearch/plugin": "workspace:*",
    "@anysearch/retriever": "workspace:*",
    "@anysearch/store": "workspace:*",
    "express": "^4.21.0",
    "zod": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/better-sqlite3": "^9.6.0"
  },
  "types": "./dist/index.d.cts"
}
