{
  "name": "@anysearch-cli/mcp",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "ans-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "domains"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/sync-domains.mjs && tsup",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" --test-timeout=30000",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tavily/core": "^0.7.7",
    "better-sqlite3": "^13.0.3",
    "eventsource-parser": "^4.1.1",
    "exa-js": "^2.26.0",
    "express": "^4.21.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.2.0",
    "@earendil-works/pi-coding-agent": "1.5.1"
  },
  "devDependencies": {
    "@anysearch-cli/kernel": "workspace:*",
    "@anysearch-cli/plugin": "workspace:*",
    "@anysearch-cli/retriever": "workspace:*",
    "@anysearch-cli/store": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@anysearch-cli/embedding": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anysearch-cli/embedding": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xxx91n/anysearch-cli.git",
    "directory": "apps/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
