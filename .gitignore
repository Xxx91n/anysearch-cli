# runtime policy cache (ADR-0055)
.anysearch-cli/

# R68 audit F-A2: agy adapter writes .antigravity/rules/anysearch.mdc into the
# hook cwd as a runtime fallback — never a repo artifact.
.antigravity/

# local-markdown issue tracker / round artifacts — D5c: .scratch is ignored by default,
# but per-round governance products (ledger/handoff/reports) are un-ignored via !rules below
# and DO get committed with their ticket.
.scratch/*
# ADR-0061: round-60 账本/任务书/报告属治理产物随票入版本（D5c: tracked 必须 not-ignored；
# 须 .scratch/* 而非 .scratch/——父目录整体排除后子路径无法再纳回）。
!.scratch/grill-round-60/
!.scratch/grill-round-60/**
# ADR-0062: round-61 账本/任务书/报告/探针账本同规随票入版本。
!.scratch/grill-round-61/
!.scratch/grill-round-61/**
# ADR-0063: round-62 账本/任务书/报告/调研同规随票入版本。
!.scratch/grill-round-62/
!.scratch/grill-round-62/**
# ADR-0064: round-63 账本/任务书/调研报告同规随票入版本。
!.scratch/grill-round-63/
!.scratch/grill-round-63/**
# 构建产物/安装前缀仍忽略（pack 输出 + 干净装 node_modules 不入库）
.scratch/grill-round-60/t1-pack/
# ADR-0065: round-64 账本/任务书/调研报告同规随票入版本。
!.scratch/grill-round-64/
!.scratch/grill-round-64/**
# round-65 账本/任务书/调研报告同规随票入版本（ADR 号定稿后回填）。
!.scratch/grill-round-65/
!.scratch/grill-round-65/**
# round-66 账本/任务书/调研报告同规随票入版本（ADR 号定稿后回填）。
!.scratch/grill-round-66/
!.scratch/grill-round-66/**

# round-67 账本/任务书/调研报告同规随票入版本（ADR 号定稿后回填）。
!.scratch/grill-round-67/
!.scratch/grill-round-67/**
!.scratch/grill-round-68/
!.scratch/grill-round-68/**

